<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="393dp"
    android:layout_height="817dp"
    android:background="@color/bg_dark_1">

    <!-- Main Game Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Upper Section (480px) - Game Area -->
        <FrameLayout
            android:id="@+id/upper_section"
            android:layout_width="match_parent"
            android:layout_height="480dp"
            android:background="@color/bg_dark_2">

            <!-- Game View for rendering the scene -->
            <com.game.walkinghero.GameView
                android:id="@+id/game_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- UI Overlays -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Top Stats Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Player Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/ui_panel_bg"
                        android:padding="6dp">

                        <TextView
                            android:id="@+id/player_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Héroe"
                            android:textColor="@color/text_white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/player_power"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Poder: 100"
                            android:textColor="@color/text_gold"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- World Progress -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/ui_panel_bg"
                        android:padding="6dp"
                        android:layout_marginStart="4dp">

                        <TextView
                            android:id="@+id/world_level"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mundo 1"
                            android:textColor="@color/text_white"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/stage_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Desafío 0/3"
                            android:textColor="@color/text_gold"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- Currency Display -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/ui_panel_bg"
                        android:padding="6dp"
                        android:layout_marginStart="4dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💰 "
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/gold_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/text_gold"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💎 "
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/gem_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/text_white"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Lower Section (337px) - UI Panel -->
        <LinearLayout
            android:id="@+id/lower_section"
            android:layout_width="match_parent"
            android:layout_height="337dp"
            android:background="@color/bg_dark_3"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Equipment Slots Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <!-- HP -->
                <include layout="@layout/equipment_slot"
                    android:id="@+id/slot_hp" />

                <!-- ATTACK -->
                <include layout="@layout/equipment_slot"
                    android:id="@+id/slot_attack" />

                <!-- DEFENSE -->
                <include layout="@layout/equipment_slot"
                    android:id="@+id/slot_defense" />

                <!-- AGILITY -->
                <include layout="@layout/equipment_slot"
                    android:id="@+id/slot_agility" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <!-- CRITICAL -->
                <include layout="@layout/equipment_slot"
                    android:id="@+id/slot_critical" />

                <!-- SPEED -->
                <include layout="@layout/equipment_slot"
                    android:id="@+id/slot_speed" />

                <!-- EVASION -->
                <include layout="@layout/equipment_slot"
                    android:id="@+id/slot_evasion" />

                <!-- REGENERATION -->
                <include layout="@layout/equipment_slot"
                    android:id="@+id/slot_regen" />
            </LinearLayout>

            <!-- Kunai Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <!-- Kunai Display -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/ui_panel_bg"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/kunai_icon"
                        android:contentDescription="Kunai" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗡️ Kunai"
                        android:textColor="@color/text_white"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Kunai Level -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/ui_panel_bg"
                    android:padding="6dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Nivel"
                        android:textColor="@color/text_gold"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/kunai_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textColor="@color/text_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Auto Panel -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/ui_panel_bg"
                    android:padding="6dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️ Auto"
                        android:textColor="@color/text_gold"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textColor="@color/text_white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Main Action Buttons -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:columnCount="3"
                android:rowCount="2"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true">

                <Button
                    android:id="@+id/btn_event"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_columnWeight="1"
                    android:text="🎉 EVENTO"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    style="@style/GameButton" />

                <Button
                    android:id="@+id/btn_dungeon"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_columnWeight="1"
                    android:text="🏰 MAZMORRAS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    style="@style/GameButton" />

                <Button
                    android:id="@+id/btn_battle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_columnWeight="1"
                    android:text="⚔️ BATALLA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    style="@style/GameButton" />

                <Button
                    android:id="@+id/btn_hero"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_columnWeight="1"
                    android:text="🦸 HÉROE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    style="@style/GameButton" />

                <Button
                    android:id="@+id/btn_clans"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_columnWeight="1"
                    android:text="👥 CLANES"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    style="@style/GameButton" />

                <Button
                    android:id="@+id/btn_shop"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_columnWeight="1"
                    android:text="🛒 TIENDA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    style="@style/GameButton" />
            </GridLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
