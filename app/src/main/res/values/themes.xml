<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.RPGAdventure" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryVariant">@color/bg_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/diamond</item>
        <item name="colorSecondaryVariant">@color/bg_medium</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_darker</item>
        <!-- Background color -->
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>
    
    <!-- Button Style -->
    <style name="RPGButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/button_gradient</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:elevation">4dp</item>
    </style>
    
    <!-- Equipment Slot Style -->
    <style name="EquipmentSlot" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_medium</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/ui_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
