<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="393dp"
    android:layout_height="817dp"
    android:background="@color/bg_dark"
    tools:context=".MainActivity">

    <!-- Sección Superior (480px) -->
    <FrameLayout
        android:id="@+id/upperSection"
        android:layout_width="393dp"
        android:layout_height="480dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Game View Container -->
        <com.game.rpg.GameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- Separador -->
    <View
        android:id="@+id/divider"
        android:layout_width="393dp"
        android:layout_height="2dp"
        android:background="@color/gold"
        app:layout_constraintTop_toBottomOf="@id/upperSection"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Sección Inferior (337px) -->
    <LinearLayout
        android:id="@+id/lowerSection"
        android:layout_width="393dp"
        android:layout_height="337dp"
        android:orientation="vertical"
        android:background="@color/bg_medium"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Equipment Slots Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <include layout="@layout/item_equipment_slot"
                android:id="@+id/slotHP" />
            <include layout="@layout/item_equipment_slot"
                android:id="@+id/slotAttack" />
            <include layout="@layout/item_equipment_slot"
                android:id="@+id/slotDefense" />
            <include layout="@layout/item_equipment_slot"
                android:id="@+id/slotAgility" />

        </LinearLayout>

        <!-- Equipment Slots Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <include layout="@layout/item_equipment_slot"
                android:id="@+id/slotCritic" />
            <include layout="@layout/item_equipment_slot"
                android:id="@+id/slotSpeed" />
            <include layout="@layout/item_equipment_slot"
                android:id="@+id/slotEvasion" />
            <include layout="@layout/item_equipment_slot"
                android:id="@+id/slotRegen" />

        </LinearLayout>

        <!-- Kunai Panel Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <!-- Kunai Sprite Panel -->
            <LinearLayout
                android:layout_width="120dp"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/kunai_panel_bg"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_kunai"
                    android:contentDescription="Kunai" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗡️"
                    android:textSize="20sp"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Kunai Level Panel -->
            <LinearLayout
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/kunai_panel_bg"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nivel"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/gold"
                    android:textStyle="bold"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Auto Mode Panel -->
            <LinearLayout
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/kunai_panel_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="@color/diamond"
                    android:textStyle="bold"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Main Buttons Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:columnCount="3"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/main_button_bg"
                android:text="EVENTO"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="11sp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/main_button_bg"
                android:text="MAZMORRAS"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="11sp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/main_button_bg"
                android:text="BATALLA"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="11sp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/main_button_bg"
                android:text="HÉROE"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="11sp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/main_button_bg"
                android:text="CLANES"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="11sp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/main_button_bg"
                android:text="TIENDA"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="11sp" />

        </GridLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
