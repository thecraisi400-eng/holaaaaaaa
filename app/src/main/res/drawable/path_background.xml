<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo del camino de tierra -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#6B4423"
                android:endColor="#8B6914"
                android:angle="0" />
        </shape>
    </item>
    <!-- Textura del camino -->
    <item>
        <bitmap
            android:src="@drawable/path_texture"
            android:tileMode="repeat" />
    </item>
</layer-list>
